# Proxy público mínimo para Grok (vía Tailscale Funnel). Solo expone, bajo una ruta secreta:
#   /<clave>/mcp        -> MCP de GLP (lectura + anotar puntuación, notas y molienda)
#   /<clave>/extra/mcp  -> este puente (asignar café y dosis a un shot)
# Todo lo demás devuelve 404. Las variables GLP_* se rellenan al arrancar el contenedor.
server {
    listen 8100;
    server_tokens off;
    client_max_body_size 1m;

    location = /${GLP_GROK_MCP_KEY}/mcp {
        proxy_pass http://glp:8099/api/mcp;
        proxy_http_version 1.1;
        proxy_set_header Host localhost:8099;
        proxy_set_header X-GLP-Token "${GLP_TOKEN}";
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    location = /${GLP_GROK_MCP_KEY}/extra/mcp {
        proxy_pass http://glp-grok-bridge:8200/mcp;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
    }

    location / {
        return 404;
    }
}
